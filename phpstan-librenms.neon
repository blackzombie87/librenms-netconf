# Analysis against a real LibreNMS checkout (LIBRENMS_PATH), which is what CI and the
# development container run: the real models, interfaces and views replace stubs/librenms.stub.php.
# phpstan.neon is the bare-checkout fallback; see dev/README.md.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    stubFiles:
        - stubs/librenms-overrides.stub.php
    scanFiles:
        # phpseclib 4 only from librenms#20677 on; a scanned file declares it where it is missing
        - stubs/phpseclib4.stub.php
    bootstrapFiles:
        - dev/phpstan-librenms-bootstrap.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Rrd::name() returns a string up to 26.9 and an RrdPath after librenms#20649, which is
        # what checkRrdExists() then demands; the plugin hands that value on unchanged
        -
            identifier: argument.type
            message: '#checkRrdExists\(\) expects LibreNMS\\RRD\\RrdPath, string\|Stringable given#'
            reportUnmatched: false
        # each LibreNMS has one of the two graph APIs (librenms#21118) and one of the two names
        # of the sensor enum (librenms#20764); the code picks the one present at runtime
        -
            identifier: class.notFound
            path: src/Support/CoreGraph.php
            reportUnmatched: false
        -
            identifier: staticMethod.notFound
            message: '#Rrd::graph\(\)#'
            path: src/Support/CoreGraph.php
            reportUnmatched: false
        -
            identifier: class.notFound
            message: '#LibreNMS\\Enum\\Sensor(Type)? not found#'
            path: src/Collect/SensorWriter.php
            reportUnmatched: false
        # pollingMethods() is only asked by cores from librenms#20992 on, the ones with the enum
        -
            identifier: class.notFound
            message: '#LibreNMS\\Enum\\PollingMethodType#'
            path: src/Modules/Netconf.php
            reportUnmatched: false
        # Laravel 13 LibreNMS: larastan types Plugin::$settings from the column, not the array
        # cast; core assigns arrays the same way (PluginManager::setSettings())
        -
            identifier: assign.propertyType
            message: '#Plugin::\$settings \(string\|null\) does not accept#'
            reportUnmatched: false
