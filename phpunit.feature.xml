<?xml version="1.0" encoding="UTF-8"?>
<!--
  Feature tests against a LibreNMS installation and its test database. Run inside an
  environment that has LibreNMS (see dev/README.md "Feature tests"):

    LIBRENMS_PATH=/path/to/librenms vendor/bin/phpunit -c phpunit.feature.xml

  The testing connection of LibreNMS (config/database.php: DB_TEST_*) must point at a
  migrated database; every test runs in a transaction that is rolled back.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Feature/bootstrap.php"
         colors="true"
         failOnSkipped="true"
         cacheDirectory=".phpunit.cache/feature">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DBTEST" value="1"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CONFIG_CACHE_TTL" value="0"/>
    </php>
</phpunit>
